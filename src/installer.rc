// Resource file for Nirqoba Installer
// Defines the application icon and UAC manifest

#include <windows.h>

// Application icon
1 ICON "nirqoba_installer.ico"

// UAC Manifest — requests admin elevation on launch
// (requestedExecutionLevel = requireAdministrator)
1 RT_MANIFEST "installer.manifest"

// Installer payload archive
100 RCDATA "payload.bin"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Muhammad Tahmid Ahnaf\0"
            VALUE "FileDescription",  "Nirqoba Compiler Suite Installer\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "NirqobaSetup\0"
            VALUE "LegalCopyright",   "Copyright (2026-) Muhammad Tahmid Ahnaf\0"
            VALUE "OriginalFilename", "NirqobaSetup.exe\0"
            VALUE "ProductName",      "Nirqoba Compiler Suite\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
