; Inno Setup script for Nirqoba compiler
; Generated by the Windows installer foundation

[Setup]
; Basic installer information
AppName=nirqoba Compiler
AppVersion=0.1.0
AppPublisher=Muhammad Tahmid Ahnaf
AppPublisherURL=https://freebuff.com
DefaultDirName={cmd /c "echo %ProgramFiles%\nirqoba"}
DisableDirPage=yes
UninstallDeleteProgramPages=yes
UninstallDisplayIcon=%InstDir%\nirqoba.exe
UninstallDisplayName=nirqoba Compiler
UninstallLocationMode=select
UnrestartApp=yes

; Request elevated privileges for system-wide install
; RequestExecutionLevel admin

; Add default tasks
TasksDescription=Tasks
Task descriptions=desktopicon, startmenuicon
Task=desktopicon:Create a desktop shortcut.|"@DesktopIcon"
Task=startmenuicon:Create a Start Menu shortcut.|"@StartMenuIcon"

; Files to install
FilesSource={src}
Source: "{src}\nirqoba.exe"; DestDir:{app}; Flags: ignoreversion
Source: "{src}\*.dll"; DestDir:{app}; Flags: ignoreversion
Source: "{src}\nirqoba.chm"; DestDir:{app}; Flags: ignoreversion

; Create directories
SubDir: {app}; Flags: createfolder

; Shortcut creation
Shortcut=Desktop,{app}\nirqoba.exe
Shortcut=StartMenu,{app}\nirqoba.exe

; Uninstaller
Uninstallable=yes
UninstallDelete={app}\*

[Files]
; Post-installation steps
Name: "{app}\nirqoba.exe"; Flags: dontcopy

[Icons]
Name: "{app}\nirqoba.exe"; Filename: "{src}\nirqoba.exe"
Name: "{userdesktop}\nirqoba.lnk"; Filename: "{src}\nirqoba.exe"
Name: "{userstartmenu}\nirqoba.lnk"; Filename: "{src}\nirqoba.exe"

[Run]
; Post-install message
Filename: "{code:ShowInstMsg}"

; Custom message function
function ShowInstMsg():
begin
  MsgBox("nirqoba compiler has been installed successfully." + #13#10 + \
    "You can now use the compiler from the Start Menu or desktop.", mbInformation, "Installation Complete")
end;